# Copy this file to `.env.local` for local development. It is the contract
# for which variables the app reads. When NODE_ENV=production no env file is
# read at all: the real values must be present as process environment
# variables, and the app fails fast at boot if DATABASE_URL or JWT_SECRET is
# missing (see src/config/env.validation.ts).

# PostgreSQL connection strings (example values for the local docker-compose DB)
DATABASE_URL=postgresql://prisma:prisma@localhost:5432/pizzaria_cumaru?schema=public
TEST_DATABASE_URL=postgresql://prisma:prisma@localhost:5432/pizzaria_cumaru_test?schema=public

# Secret used to sign JWTs — dev fallback is 'dev-secret-change-me'; set a
# strong value here for anything beyond local development.
JWT_SECRET=change-me

# HTTP port (defaults to 3000 when unset)
PORT=3000
