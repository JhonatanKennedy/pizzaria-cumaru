# Copy this file to `.env.local` for local development. It is the contract
# for which variables the app reads. When NODE_ENV=production no env file is
# read at all: the real values must be present as process environment
# variables, and the app fails fast at boot if CORS_ORIGINS is missing — or if
# DATABASE_URL or JWT_SECRET is missing in production (see
# src/config/env.validation.ts).

# PostgreSQL connection strings (example values for the local docker-compose DB)
DATABASE_URL=postgresql://prisma:prisma@localhost:5432/pizzaria_cumaru?schema=public
TEST_DATABASE_URL=postgresql://prisma:prisma@localhost:5432/pizzaria_cumaru_test?schema=public

# Secret used to sign access JWTs — dev fallback is 'dev-secret-change-me';
# set a strong value here for anything beyond local development.
JWT_SECRET=change-me

# Secret used to sign refresh JWTs — must differ from JWT_SECRET, since that
# difference is what makes a refresh token fail signature verification when it
# is offered as an access token. The app refuses to boot when the two are equal.
JWT_REFRESH_SECRET=change-me-refresh

# Origins allowed to call the API from a browser, comma-separated. Required in
# every mode: a missing value stops the boot rather than starting with an
# allowlist that silently blocks the SPA. An entry containing '*' is refused —
# the match is exact, so a subdomain pattern would never answer. Set the real
# production origin before deploying, e.g.
# CORS_ORIGINS=https://app.pizzariacumaru.com.br
CORS_ORIGINS=http://localhost:5173

# HTTP port (defaults to 3000 when unset)
PORT=3000
