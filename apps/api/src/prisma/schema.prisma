// use prisma-next
generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            Int       @id @default(autoincrement())
  email         String    @unique
  name          String?
  role          String
  passwordHash  String
  failedAttempts Int      @default(0)
  lockedUntil   DateTime?
}

model DeniedToken {
  jti       String   @id
  expiresAt DateTime
}

model Order {
  id              String               @id @default(uuid())
  userId          Int
  type            String
  status          String
  paymentType     String?
  tableId         String?
  table           Table?               @relation(fields: [tableId], references: [id], onDelete: Restrict)
  customerName    String?
  phone           String?
  address         String?
  notes           String?
  createdAt       DateTime
  deliveredAt     DateTime?
  closedAt        DateTime?
  cancelledAt     DateTime?
  items           OrderItem[]
  cancellations   OrderCancellation[]
}

model Table {
  id     String  @id @default(uuid())
  number Int     @unique
  orders Order[]
}

model OrderItem {
  id                  String   @id @default(uuid())
  orderId             String
  itemId              String
  unitPrice           Float
  quantity            Int
  status              String?
  requiresPreparation Boolean
  // Ordered pizza composition: [{ name, pieces }[]], base flavor first.
  // Stored as JSONB; non-pizza items keep an empty array.
  flavors             Json
  notes               String?
  createdAt           DateTime
  order               Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model OrderCancellation {
  id          String   @id @default(uuid())
  orderId     String
  itemId      String
  cancelledAt DateTime
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Item {
  id                  String           @id @default(uuid())
  name                String
  description         String
  price               Float
  category            String
  requiresPreparation Boolean
  ingredients         ItemIngredient[]
}

model Ingredient {
  id      String           @id @default(uuid())
  name    String
  inStock Boolean
  items   ItemIngredient[]
}

model ItemIngredient {
  itemId       String
  ingredientId String
  item         Item       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@id([itemId, ingredientId])
}
