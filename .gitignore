# npm workspaces hoists dependencies to the root
node_modules/

# Build output and test artifacts
dist/
coverage/
*.tsbuildinfo

# Environment: each app reads its own — the tools never look at the root
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*

# The e2e suites' PID lockfile — see apps/api/.claude/rules/02-testing.md
.e2e.lock

# Cypress writes these on every failing run; they are evidence, not source
apps/web/cypress/screenshots/
apps/web/cypress/videos/
apps/web/cypress/downloads/
